SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_BEAT_DB=2

EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@askpupkin.ru

CENTRIFUGO_API_URL=http://localhost:8003/api
CENTRIFUGO_API_KEY=your-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=your-centrifugo-token-secret
CENTRIFUGO_WS_URL=ws://localhost:8003/connection/websocket
